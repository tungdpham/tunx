{
  "max_steps": 20000,
  "batch_size": 8,
  "gradient_accumulation_steps": 1,
  "progress_print_interval": 10,
  "num_threads": 8,
  "profiler_type": "NONE",
  "print_layer_profiling": true,
  "print_memory_usage": true,
  "device": "CUDA:0",
  "model_name": "gpt2_small",
  "model_path": "",
  "dataset_name": "open-web-text",
  "dataset_path": "../data/open-web-text",
  "io_dtype": "BF16",
  "param_dtype": "BF16",
  "compute_dtype": "FP32",
  "optimizer": {
    "type": "adam",
    "learning_rate": 0.0003,
    "beta1": 0.9,
    "beta2": 0.995,
    "epsilon": 1e-8,
    "weight_decay": 3e-4,
    "decouple_weight_decay": false
  },
  "scheduler": {
    "type": "warmup_cosine_annealing",
    "start_lr": 0.00015,
    "base_lr": 0.0003,
    "warmup_steps": 2000,
    "eta_min": 0.0
  },
  "loss": {
    "type": "logsoftmax_cross_entropy"
  },
  "log_mode": {
    "log_loss": true,
    "log_accuracy": true,
    "log_precision": false,
    "log_recall": false,
    "log_f1_score": false,
    "log_perplexity": true,
    "log_top_k_accuracy": false,
    "log_mae": false,
    "log_mse": false,
    "log_rmse": false
  }
}