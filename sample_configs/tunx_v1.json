{
  "benchmark_mode": true,
  "epochs": 1,
  "batch_size": 64,
  "max_steps": -1,
  "gradient_accumulation_steps": 1,
  "progress_print_interval": 10,
  "num_threads": 8,
  "profiler_type": "NONE",
  "print_layer_profiling": true,
  "print_memory_usage": true,
  "print_ablation": false,
  "bootstrap_offload": true,
  "device": "CUDA:0",
  "model_name": "tunx_v1",
  "model_path": "",
  "dataset_name": "imagenet-100",
  "dataset_path": "../data/imagenet-100",
  "io_dtype": "BF16",
  "param_dtype": "BF16",
  "compute_dtype": "FP32",
  "optimizer": {
    "type": "adam",
    "learning_rate": 0.00015,
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1e-8,
    "weight_decay": 3e-4,
    "decouple_weight_decay": false
  },
  "scheduler": {
    "type": "warmup_cosine_annealing",
    "start_lr": 0.00015,
    "base_lr": 0.0003,
    "warmup_steps": 100,
    "T_max": 10,
    "eta_min": 0.0
  },
  "loss": {
    "type": "logsoftmax_cross_entropy"
  }
}